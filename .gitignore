# Raw data files — too large for GitHub, regenerated by ingest_pbp.py
data/

# Python bytecode — auto-generated by Python, not source code
__pycache__/
*.pyc

# Environment variables — contains secrets and credentials, never commit
.env

# Jupyter notebook checkpoints — auto-generated by Jupyter, not source code
.ipynb_checkpoints/

# Conda/pip virtual environment folders — dependencies installed locally
env/

venv/

# Terraform — state contains sensitive resource details, .terraform is provider cache
infra/.terraform/
infra/terraform.tfstate
infra/terraform.tfstate.backup
infra/terraform.tfvars

# Logs
logs/
dbt/nfl_lakehouse/logs/

# dbt compiled output — regenerated on every run
dbt/nfl_lakehouse/target/

# Handoff/session notes and tooling config — local only, not part of the repo
HANDOFF.md
CLAUDE.md
.claude/worktrees/
